# Supabase Dashboard > Project Settings > API 에서 복사
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=서비스_롤_키(절대_프론트에_넣지_말것)
SUPABASE_ANON_KEY=anon_공개_키

# (선택) 레거시 JWT Secret. 비워두면 Supabase Auth 서버에 토큰을 물어봐서 검증합니다.
SUPABASE_JWT_SECRET=

# 프론트엔드 주소 (쉼표로 여러 개)
ALLOWED_ORIGINS=http://localhost:5173

# 회원 로그인용 가상 이메일 도메인: {학번}@{도메인}  (실제 메일이 가지 않으므로 아무 도메인이나 가능)
MEMBER_EMAIL_DOMAIN=member.debate-club.local

# 같은 시간대에 허용할 최대 팀 수
MAX_CONCURRENT_RESERVATIONS=2
